# Copy this file to .env.local and fill in the values.
#   PowerShell:  Copy-Item .env.local.example .env.local
# .env.local is git-ignored. Never commit real keys.
#
# Leave the Supabase values empty to run the site on local seed data.

# --- Site ---------------------------------------------------------------
# Public base URL, used for canonical links, sitemap and Open Graph images.
# Local dev: http://localhost:3000   Production: https://kaymotorsgroup.co.za
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API Keys) ----------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co  (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy "anon" key. Safe for the
# browser: Row Level Security limits what it can do.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy "service_role" key.
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---------------------------------------------------------------
# In production, /admin returns 404 unless this is exactly "true".
# Set to true on Vercel once ADMIN_EMAILS and the Supabase user exist.
# Ignored in `npm run dev` (admin is always on locally, login still required).
ADMIN_ENABLED=false

# Who may sign in to /admin (comma separated). Each person also needs a user
# in Supabase -> Authentication -> Users. Empty = nobody can sign in.
ADMIN_EMAILS=
